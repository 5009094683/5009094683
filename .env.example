# Copy to .env for local development. Every value below is optional locally:
# the defaults in packages/config/src/index.ts boot the whole system against
# a local PostgreSQL and the bundled OTA simulator.

# --- Core -------------------------------------------------------------------
# DATABASE_URL=postgres://pms:pms@localhost:5432/pms
# API_PORT=4000
# WEB_URL=http://localhost:3000
# BOOKING_URL=http://localhost:3001
# Browser-visible base URL of the API (the back office proxies /api to it).
# API_PUBLIC_URL=http://localhost:3000/api

# Required in production. Generate with: openssl rand -base64 32
# APP_ENCRYPTION_KEY=
# Comma-separated older keys, kept while rotating.
# APP_ENCRYPTION_KEY_PREVIOUS=

# --- Channel manager (Channex) ------------------------------------------------
# With no key set (and outside production) the bundled OTA simulator is used.
# For the Channex sandbox: create a free account at https://staging.channex.io,
# add an API key, and set both of these. Production is https://app.channex.io/api/v1.
# CHANNEX_API_KEY=
# CHANNEX_BASE_URL=https://staging.channex.io/api/v1
# A long random value. Channex sends it back with every webhook call.
# Generate with: openssl rand -hex 32
# CHANNEX_WEBHOOK_SECRET=
# Only when the webhook is HMAC-signed with a Channex signing key.
# CHANNEX_WEBHOOK_SIGNING_SECRET=
# Shortest pause between two pushes for one property (Channex allows 10 a minute).
# CHANNEX_MIN_PUSH_INTERVAL_MS=6500

# --- Sync worker ---------------------------------------------------------------
# WORKER_CONCURRENCY=4
# Restate the whole horizon once a night as a safety net.
# SYNC_NIGHTLY_FULL=true
# How many days ahead the daily comparison with the channels looks.
# SYNC_DRIFT_CHECK_DAYS=60

# --- AI ----------------------------------------------------------------------
# Without a key the AI features fall back to rule-based behaviour.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AI_DOCUMENT_CAPTURE_ENABLED=false

# --- Email ---------------------------------------------------------------------
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Sea Breeze Hotels <reservations@example.com>"

# Reservations mailbox read by the email adapter.
# RESERVATIONS_IMAP_HOST=
# RESERVATIONS_IMAP_USER=
# RESERVATIONS_IMAP_PASSWORD=

# Guest replies: messages sent from the inbox carry this Reply-To. Have your
# mail service deliver its mail to POST /webhooks/inbox/email with the secret.
# INBOX_REPLY_ADDRESS=stay@example.com
# INBOUND_EMAIL_SECRET=

# --- Payments ------------------------------------------------------------------
# Guests pay on the gateway's own page; card details never reach this system.
# With no keys, development uses a stand-in page that approves everything;
# production refuses to start without a gateway (or PAYMENT_PROVIDER=mock).
# Razorpay: point a webhook for "payment_link.paid" at POST /webhooks/payments/razorpay.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Stripe: point a webhook for "checkout.session.completed" and
# "checkout.session.async_payment_succeeded" at POST /webhooks/payments/stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- WhatsApp Business ---------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v27.0
# Webhook for the WhatsApp app: <API_PUBLIC_URL>/webhooks/whatsapp

# --- Files ---------------------------------------------------------------------
# Identity documents and attachments, encrypted with APP_ENCRYPTION_KEY before
# they are written. Mount a persistent volume here in production.
# STORAGE_DIR=./var/files

# --- Other systems -------------------------------------------------------------
# API keys are made under Settings, Integrations. Each key may make this many
# requests a minute on each API server.
# API_KEY_RATE_LIMIT_PER_MINUTE=600
# Outbound webhooks may only call addresses on the public internet in
# production. Set to true only if a receiver really lives on a private network.
# WEBHOOKS_ALLOW_PRIVATE_HOSTS=false

# --- Monitoring ----------------------------------------------------------------
# GET /metrics answers in the Prometheus text format to a caller that sends
# "Authorization: Bearer <this value>". Unset: the route is not served.
# Generate with: openssl rand -hex 32
# METRICS_TOKEN=

# --- Backups ---------------------------------------------------------------------
# Where scripts/backup.sh writes database dumps.
# BACKUP_DIR=./var/backups
